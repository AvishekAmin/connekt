# Server & Runtime Configuration
PORT=8080
NODE_ENV=production

# MongoDB Connection String (Points to 'mongo' container in connekt-network)
MONGO_URI=mongodb://mongo:27017/connekt

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:5173

# Frontend Vite Build-Time Variable (Accessed by browser)
VITE_BACKEND_URL=http://localhost:8080

# JWT Security Secrets (Must be at least 32 characters long)
JWT_ACCESS_SECRET=connekt_production_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=connekt_production_jwt_refresh_secret_min_32_characters_long

# JWT Lifespans
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# WebRTC ICE Server Configuration
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
